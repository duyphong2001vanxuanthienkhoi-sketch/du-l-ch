# File MẪU — không chứa giá trị thật, được commit lên git.
# Vercel đọc chính file này để gợi ý danh sách biến khi import project.
# Giá trị thật khai ở .env.local (đã .gitignore).

# ─── BẮT BUỘC ────────────────────────────────────────────────────────────────

# Neon Postgres — CSDL RIÊNG của app du lịch.
# ⚠️ KHÔNG dùng chung với Chợ Số Hồng Gai (xem THIET-KE-APP-DU-LICH.md mục 12).
DATABASE_URL = ''

# Chuỗi bí mật ký phiên đăng nhập. Sinh chuỗi ngẫu nhiên riêng cho từng dự án:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET = ''


# ─── CẦN KHI TRIỂN KHAI LÊN VERCEL ───────────────────────────────────────────

# Vercel Blob — lưu ảnh địa điểm và ảnh du khách đính kèm đánh giá.
# Chạy máy: bỏ trống cũng được, ảnh tự lưu vào public/uploads.
# Trên Vercel: BẮT BUỘC (đĩa chỉ đọc). Nối Blob store vào project thì Vercel TỰ tiêm,
# không cần khai ở đây.
BLOB_READ_WRITE_TOKEN = ''

# Gốc URL cho sitemap.xml và thẻ chia sẻ. Trên Vercel để trống, tự suy từ VERCEL_URL.
APP_URL = ''


# ─── TUỲ TÍNH NĂNG ───────────────────────────────────────────────────────────

# Web Push — thông báo "lễ hội sắp diễn ra". Miễn phí, tự sinh khoá:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY = ''
VAPID_PRIVATE_KEY = ''
VAPID_SUBJECT = 'mailto:ban@example.com'
NEXT_PUBLIC_VAPID_PUBLIC_KEY = ''

# Brevo — CHỈ dùng gửi email quên mật khẩu. Bỏ qua được nếu chỉ có 1–2 admin.
BREVO_API_KEY = ''
BREVO_TU_EMAIL = ''
BREVO_TU_TEN = 'Khám Phá Hồng Gai'


# ─── ĐÃ BỎ ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_CURRENCY_SYMBOL : app không bán hàng nữa
# PUSHER_*                    : chat khách↔quán đã gỡ ở giai đoạn 3
